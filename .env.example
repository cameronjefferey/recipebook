# Postgres. In production this points at the `pinkbox` schema inside the
# existing camino-db instance on Render. Append ?sslmode=require for the
# external Render URL; the internal URL does not need it.
DATABASE_URL=postgres://localhost:5432/pinkbox

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Transcribing photographed recipe cards and cookbook pages.
ANTHROPIC_API_KEY=

# Anyone with this code can create an account. Keep it to family.
INVITE_CODE=
